
########## 0. Tooling: etcdutl/etcdctl matching the running etcd version on every control plane
running etcd version: 3.6.5

$ [cp1] curl -fsSL --retry 10 --retry-delay 3 --retry-all-errors https://github.com/etcd-io/etcd/releases/download/v3.6.5/etcd-v3.6.5-linux-arm64.tar.gz | sudo tar xz --strip-components=1 -C /usr/local/bin etcd-v3.6.5-linux-arm64/etcdctl etcd-v3.6.5-linux-arm64/etcdutl && etcdutl version | head -1
etcdutl version: 3.6.5

$ [cp2] curl -fsSL --retry 10 --retry-delay 3 --retry-all-errors https://github.com/etcd-io/etcd/releases/download/v3.6.5/etcd-v3.6.5-linux-arm64.tar.gz | sudo tar xz --strip-components=1 -C /usr/local/bin etcd-v3.6.5-linux-arm64/etcdctl etcd-v3.6.5-linux-arm64/etcdutl && etcdutl version | head -1
etcdutl version: 3.6.5

$ [cp3] curl -fsSL --retry 10 --retry-delay 3 --retry-all-errors https://github.com/etcd-io/etcd/releases/download/v3.6.5/etcd-v3.6.5-linux-arm64.tar.gz | sudo tar xz --strip-components=1 -C /usr/local/bin etcd-v3.6.5-linux-arm64/etcdctl etcd-v3.6.5-linux-arm64/etcdutl && etcdutl version | head -1
etcdutl version: 3.6.5

########## 1. Create a namespace with some resources

$ [cp1] kubectl create namespace backup-demo
namespace/backup-demo created

$ [cp1] kubectl -n backup-demo create deployment web --image=nginx --replicas=2
deployment.apps/web created

$ [cp1] kubectl -n backup-demo create configmap app-config --from-literal=greeting=hello-from-before-the-backup
configmap/app-config created

$ [cp1] kubectl -n backup-demo create secret generic app-secret --from-literal=password=s3cr3t
secret/app-secret created

$ [cp1] kubectl -n backup-demo expose deployment web --port=80
service/web exposed

$ [cp1] kubectl -n backup-demo rollout status deployment/web --timeout=180s

########## 3. Make a change AFTER the snapshot (it must be lost by the restore) and then 'accidentally' delete the namespace

$ [cp1] kubectl create configmap created-after-backup -n default --from-literal=note=i-will-not-survive-the-restore
configmap/created-after-backup created

$ [cp1] kubectl delete namespace backup-demo --wait=true
namespace "backup-demo" deleted

$ [cp1] kubectl get namespace
NAME               STATUS   AGE
calico-apiserver   Active   89m
calico-system      Active   88m
default            Active   89m
kube-node-lease    Active   89m
kube-public        Active   89m
kube-system        Active   89m
tigera-operator    Active   89m

$ [cp1] kubectl get all -n backup-demo
No resources found in backup-demo namespace.

########## 4. Restore. Copy the snapshot to every control plane
initial-cluster: cp1=https://192.168.105.3:2380,cp2=https://192.168.105.6:2380,cp3=https://192.168.105.5:2380

########## 4a. Stop kube-apiserver and etcd on ALL control planes (move their static-pod manifests away)

$ [cp1] sudo mkdir -p /etc/kubernetes/manifests-stopped && sudo mv /etc/kubernetes/manifests/kube-apiserver.yaml /etc/kubernetes/manifests/etcd.yaml /etc/kubernetes/manifests-stopped/

$ [cp2] sudo mkdir -p /etc/kubernetes/manifests-stopped && sudo mv /etc/kubernetes/manifests/kube-apiserver.yaml /etc/kubernetes/manifests/etcd.yaml /etc/kubernetes/manifests-stopped/

$ [cp3] sudo mkdir -p /etc/kubernetes/manifests-stopped && sudo mv /etc/kubernetes/manifests/kube-apiserver.yaml /etc/kubernetes/manifests/etcd.yaml /etc/kubernetes/manifests-stopped/

$ [cp1] for i in $(seq 1 60); do ss -tln | grep -qE ":(2379|6443) " || break; sleep 2; done; if ss -tln | grep -qE ":(2379|6443) "; then echo STILL-RUNNING; else echo "etcd and kube-apiserver are stopped"; fi
etcd and kube-apiserver are stopped

$ [cp2] for i in $(seq 1 60); do ss -tln | grep -qE ":(2379|6443) " || break; sleep 2; done; if ss -tln | grep -qE ":(2379|6443) "; then echo STILL-RUNNING; else echo "etcd and kube-apiserver are stopped"; fi
etcd and kube-apiserver are stopped

$ [cp3] for i in $(seq 1 60); do ss -tln | grep -qE ":(2379|6443) " || break; sleep 2; done; if ss -tln | grep -qE ":(2379|6443) "; then echo STILL-RUNNING; else echo "etcd and kube-apiserver are stopped"; fi
etcd and kube-apiserver are stopped


########## 4. Argo CD v3.5.6 (full install: API server + web UI + CLI access; Dex and notifications scaled to 0 to save memory)

$ [cp1] kubectl create namespace argocd --dry-run=client -o yaml | kubectl apply -f -
namespace/argocd created

$ [cp1] kubectl apply --server-side --force-conflicts -n argocd -f https://raw.githubusercontent.com/argoproj/argo-cd/v3.5.6/manifests/install.yaml 2>&1 | tail -3
networkpolicy.networking.k8s.io/argocd-redis-network-policy serverside-applied
networkpolicy.networking.k8s.io/argocd-repo-server-network-policy serverside-applied
networkpolicy.networking.k8s.io/argocd-server-network-policy serverside-applied

$ [cp1] kubectl -n argocd scale deployment argocd-dex-server argocd-notifications-controller --replicas=0
deployment.apps/argocd-dex-server scaled
deployment.apps/argocd-notifications-controller scaled

$ [cp1] kubectl -n argocd patch configmap argocd-cmd-params-cm --type merge -p '{"data":{"server.insecure":"true"}}'
configmap/argocd-cmd-params-cm patched

$ [cp1] kubectl -n argocd rollout restart deployment/argocd-server
deployment.apps/argocd-server restarted

$ [cp1] kubectl apply -f /tmp/argocd-ui.yaml
service/argocd-server-nodeport created

$ [cp1] kubectl -n argocd rollout status statefulset/argocd-application-controller --timeout=300s
Waiting for 1 pods to be ready...
partitioned roll out complete: 1 new pods have been updated...

$ [cp1] kubectl -n argocd rollout status deployment/argocd-server --timeout=300s
Waiting for deployment "argocd-server" rollout to finish: 1 old replicas are pending termination...
Waiting for deployment "argocd-server" rollout to finish: 1 old replicas are pending termination...
deployment "argocd-server" successfully rolled out

$ [cp1] kubectl -n argocd wait --for=condition=Available deployment --all --timeout=300s
deployment.apps/argocd-applicationset-controller condition met
deployment.apps/argocd-dex-server condition met
deployment.apps/argocd-notifications-controller condition met
deployment.apps/argocd-redis condition met
deployment.apps/argocd-repo-server condition met
deployment.apps/argocd-server condition met
Argo CD UI: http://192.168.105.2:30090   (user admin; password: kubectl -n argocd get secret argocd-initial-admin-secret -o jsonpath='{.data.password}' | base64 -d)


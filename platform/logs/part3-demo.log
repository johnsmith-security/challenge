########## 4. Create a second environment with kubectl (size M), then resize it

$ [cp1] kubectl apply -f - <<'EOF'
apiVersion: platform.kiratech.io/v1alpha1
kind: TeamEnvironment
metadata:
  name: green
spec:
  teamName: green
  size: M
  repoURL: http://gitea-http.gitea.svc.cluster.local:3000/platform/team-blue-app.git
EOF
teamenvironment.platform.kiratech.io/green created

$ [cp1] kubectl get teamenvironments
NAME    TEAM    SIZE   SYNCED   READY   COMPOSITION       AGE
blue    blue    S      True     True    teamenvironment   25s
green   green   M      True     True    teamenvironment   4s
--- quota of S (blue) vs M (green)

$ [cp1] kubectl get resourcequota -A -o 'custom-columns=NS:.metadata.namespace,REQ_CPU:.spec.hard.requests\.cpu,REQ_MEM:.spec.hard.requests\.memory,LIM_CPU:.spec.hard.limits\.cpu,LIM_MEM:.spec.hard.limits\.memory,PODS:.spec.hard.pods' | grep -E 'NS|team-'
NS           REQ_CPU   REQ_MEM   LIM_CPU   LIM_MEM   PODS
team-blue    500m      512Mi     1         1Gi       10
team-green   1         1Gi       2         2Gi       20
--- resize green M -> L

$ [cp1] kubectl patch teamenvironment green --type merge -p '{"spec":{"size":"L"}}'
teamenvironment.platform.kiratech.io/green patched

$ [cp1] kubectl -n team-green get resourcequota team-quota -o jsonpath='{.spec.hard}{"\n"}'
{"limits.cpu":"4","limits.memory":"4Gi","pods":"40","requests.cpu":"2","requests.memory":"2Gi"}
--- teamName is immutable (changing it would delete the namespace)

$ [cp1] kubectl patch teamenvironment green --type merge -p '{"spec":{"teamName":"yellow"}}'
The TeamEnvironment "green" is invalid: 
* <nil>: Invalid value: "object": metadata.name must equal spec.teamName (one environment per team)
* spec.teamName: Invalid value: "string": teamName is immutable (changing it would delete the namespace)
-> rejected, as expected

$ [cp1] kubectl get teamenvironments
NAME    TEAM    SIZE   SYNCED   READY   COMPOSITION       AGE
blue    blue    S      True     True    teamenvironment   25s
green   green   L      True     True    teamenvironment   4s

########## 5. RBAC: the team group can work in its own namespace only, and cannot touch platform-owned objects

$ [cp1] kubectl get rolebinding team-edit -n team-blue -o wide
NAME        ROLE               AGE   USERS   GROUPS           SERVICEACCOUNTS
team-edit   ClusterRole/edit   23s           team-blue-devs   
--- can group team-blue-devs create deployments in team-blue?

$ [cp1] kubectl auth can-i create deployments -n team-blue --as=alice --as-group=team-blue-devs
yes
-> allowed, as expected
--- ...in team-green?

$ [cp1] kubectl auth can-i create deployments -n team-green --as=alice --as-group=team-blue-devs
no
-> BLOCKED, as expected
--- ...change its own ResourceQuota / NetworkPolicy defaults? (quota: must be no)

$ [cp1] kubectl auth can-i update resourcequotas -n team-blue --as=alice --as-group=team-blue-devs
no
-> BLOCKED, as expected
--- ...read nodes (cluster scope)?

$ [cp1] kubectl auth can-i list nodes --as=alice --as-group=team-blue-devs
Warning: resource 'nodes' is not namespace scoped

no
-> BLOCKED, as expected

########## 6. Workload under default-deny: only the flows the app needs are open

$ [cp1] kubectl -n team-blue get networkpolicy
NAME                        POD-SELECTOR        AGE
allow-dns                   <none>              24s
api-clients-egress-to-api   access=api-client   23s
api-egress-to-db            app=api             23s
api-ingress-from-clients    app=api             23s
db-ingress-from-api         app=db              23s
default-deny-all            <none>              24s

$ [cp1] kubectl -n team-blue delete pod intruder client --ignore-not-found --wait=true; kubectl -n default delete pod xns --ignore-not-found --wait=true

$ [cp1] kubectl -n team-blue run intruder --image=busybox:1.28 --restart=Never -- sleep 3600 && kubectl -n team-blue run client --image=busybox:1.28 --restart=Never --labels=access=api-client -- sleep 3600 && kubectl -n default run xns --image=busybox:1.28 --restart=Never -- sleep 3600 && kubectl -n team-blue wait --for=condition=Ready pod/intruder pod/client --timeout=180s && kubectl -n default wait --for=condition=Ready pod/xns --timeout=180s
pod/intruder created
pod/client created
pod/xns created
pod/intruder condition met
pod/client condition met
pod/xns condition met
--- allowed: DNS works (platform allow-dns policy)

$ [cp1] kubectl -n team-blue exec deploy/api -- nslookup db
Server:    10.96.0.10
Address 1: 10.96.0.10 kube-dns.kube-system.svc.cluster.local

Name:      db
Address 1: 10.105.31.36 db.team-blue.svc.cluster.local
-> allowed, as expected
--- allowed: api -> db:5432 (team policy api-egress-to-db + db-ingress-from-api)

$ [cp1] kubectl -n team-blue exec deploy/api -- nc -zv -w 3 db 5432
db (10.105.31.36:5432) open
-> allowed, as expected
--- allowed: labelled client -> api:8080 (team policy api-ingress-from-clients)

$ [cp1] kubectl -n team-blue exec client -- wget -qO- -T 3 http://api:8080
api-ok
-> allowed, as expected
--- blocked: unlabelled pod in the same namespace -> api:8080

$ [cp1] kubectl -n team-blue exec intruder -- wget -qO- -T 3 http://api:8080
wget: download timed out
command terminated with exit code 1
-> BLOCKED, as expected
--- blocked: unlabelled pod -> db:5432 (only api may talk to the database)

$ [cp1] kubectl -n team-blue exec intruder -- nc -zv -w 3 db 5432
nc: db (10.105.31.36:5432): Connection timed out
command terminated with exit code 1
-> BLOCKED, as expected
--- blocked: pod from ANOTHER namespace -> api:8080

$ [cp1] kubectl -n default exec xns -- wget -qO- -T 3 http://api.team-blue.svc.cluster.local:8080
wget: download timed out
command terminated with exit code 1
-> BLOCKED, as expected
--- blocked: api -> the internet (no egress rule)

$ [cp1] kubectl -n team-blue exec deploy/api -- wget -qO- -T 3 http://1.1.1.1
wget: download timed out
command terminated with exit code 1
-> BLOCKED, as expected

$ [cp1] kubectl -n team-blue delete pod intruder client --wait=false; kubectl -n default delete pod xns --wait=false
pod "intruder" deleted from team-blue namespace
pod "client" deleted from team-blue namespace
pod "xns" deleted from default namespace

